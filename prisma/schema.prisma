// Prisma Schema — Plataforma Ares v3
// Base de datos: PostgreSQL (producción)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// ──────────────────────────────────────────
/// Modelo: Vendor
/// Representa a un vendedor/revendedor registrado en la plataforma.
/// Cada vendor opera en un espacio aislado por su ID (multi-tenant).
/// ──────────────────────────────────────────
model Vendor {
  id                 String   @id @default(cuid())
  nombre             String
  alias              String   @unique
  telefono           String   @unique
  password_hash      String
  logo_url           String?
  logo_cloudinary_id String?
  whatsapp           String?
  whatsapp_api_enabled Boolean  @default(false)
  whatsapp_api_token   String?
  plan_id            String
  fecha_registro     DateTime @default(now())
  fecha_vencimiento  DateTime
  status             String   @default("ACTIVE") // ACTIVE | SUSPENDED | EXPIRED | GUEST
  rating             Float    @default(5.0)
  biografia          String? // Descripción comercial para el marketplace
  role               String   @default("VENDOR") // SUPERADMIN | VENDOR | GUEST
  es_colaborador     Boolean  @default(false)    // Acceso limitado al panel admin
  qr_bob             String?  // QR para pagos en Bs
  qr_usd             String?  // QR para pagos en USD
  tigo_money         String?  // Número de Tigo Money

  plan          Plan           @relation(fields: [plan_id], references: [id])
  mis_servicios MiServicio[]
  pedidos       Pedido[]
  pagos         Pago[]
  credenciales  Credencial[]
  servicios_aportados ServicioBase[] @relation("ServiciosAportados")
}

/// ──────────────────────────────────────────
/// Modelo: Plan
/// Define los planes de membresía disponibles con sus límites y features.
/// ──────────────────────────────────────────
model Plan {
  id                    String   @id @default(cuid())
  nombre                String
  precio                Float
  dias                  Int
  tipo                  String   @default("SOLO_APP") // COMBO_IPTV | SOLO_APP
  limite_servicios      Int?     // null = ilimitado
  texto_limite          String?  // Ej: "Aplica comisión del 10% por venta generada"
  pedidos_automaticos   Boolean  @default(false)
  enlace_publico        Boolean  @default(false)
  marketplace_proveedor Boolean  @default(false)
  watermark_enabled     Boolean  @default(false)
  activo                Boolean  @default(true)

  vendors Vendor[]
  pagos   Pago[]
}

/// ──────────────────────────────────────────
/// Modelo: Estreno
/// Feed de noticias de estrenos de series/pelis.
/// El admin publica, el vendedor lo ve en su home.
/// ──────────────────────────────────────────
model Estreno {
  id          String   @id @default(cuid())
  titulo      String
  descripcion String?
  plataforma  String   // Legacy field (NETFLIX | DISNEY | HBO | AMAZON | OTHER)
  plataforma_id String?
  plataforma_ref Plataforma? @relation(fields: [plataforma_id], references: [id])
  fecha_estreno DateTime?
  imagen_url  String?
  activo      Boolean  @default(true)
  creado_en   DateTime @default(now())
}

/// ──────────────────────────────────────────
/// Modelo: ServicioBase
/// Catálogo maestro de servicios (Netflix, Disney+, IPTV, etc.)
/// que los vendedores pueden activar en su catálogo personal.
/// ──────────────────────────────────────────
model ServicioBase {
  id               String  @id @default(cuid())
  nombre           String
  logo_url         String
  descripcion_base String
  precio_sugerido  Float   // Precio de referencia (visible para vendors)
  precio_admin     Float   @default(0) // Precio que el admin cobra al vendor por credencial
  categoria        String  @default("STREAMING") // STREAMING | IPTV | OTRO
  es_iptv_propio   Boolean @default(false)
  estado_actual    String  @default("VERDE") // VERDE | AMARILLO | ROJO
  nota_estado      String?
  
  // -- Campos de Marketplace (Para proveedores externos) --
  proveedor_id      String?
  comision_pct      Float    @default(10.0)
  estado_aprobacion String   @default("APROBADO") // PENDIENTE | APROBADO | RECHAZADO

  activo           Boolean @default(true)

  mis_servicios MiServicio[]
  credenciales  Credencial[]
  proveedor     Vendor?        @relation("ServiciosAportados", fields: [proveedor_id], references: [id])
  imagenes      Imagen[]
  pedidos       Pedido[]
}

/// ──────────────────────────────────────────
/// Modelo: MiServicio
/// Relación N:N entre Vendor y ServicioBase.
/// El vendedor activa un servicio de su catálogo.
/// ──────────────────────────────────────────
model MiServicio {
  id            String   @id @default(cuid())
  vendor_id     String
  servicio_id   String
  precio_venta  Float    @default(0) // Precio que el vendedor cobra a su cliente final
  activo        Boolean  @default(true)
  creado_en     DateTime @default(now())

  vendor   Vendor       @relation(fields: [vendor_id], references: [id])
  servicio ServicioBase @relation(fields: [servicio_id], references: [id])

  @@unique([vendor_id, servicio_id])
}

/// ──────────────────────────────────────────
/// Modelo: Credencial
/// Cuentas (usuario/contraseña) que el admin gestiona por servicio.
/// Se asignan a vendors cuando se aprueba un pedido.
/// ──────────────────────────────────────────
model Credencial {
  id           String   @id @default(cuid())
  servicio_id  String
  usuario      String
  password     String
  perfil       String?  // "Perfil 1", "Pantalla 2", etc.
  notas        String?  // Notas internas del admin
  disponible   Boolean  @default(true) // false = ya asignada
  asignada_a   String?  // vendor_id
  pedido_id    String?  // pedido que la consumió
  provider_id  String?  // ID del proveedor que proveyó esta credencial
  creado_en    DateTime @default(now())

  servicio ServicioBase @relation(fields: [servicio_id], references: [id])
  vendor   Vendor?      @relation(fields: [asignada_a], references: [id])
  pedido   Pedido?      @relation(fields: [pedido_id], references: [id])
}

/// ──────────────────────────────────────────
/// Modelo: Imagen
/// Banco de imágenes promocionales subidas por el admin.
/// Categorías: FLYER | PROMO | ESTRENO | PARTIDO
/// ──────────────────────────────────────────
model Imagen {
  id          String   @id @default(cuid())
  titulo      String
  public_id   String // Cloudinary public_id
  url_base    String
  etiquetas   String // JSON array serializado: ["Netflix", "Estreno"]
  categoria   String   @default("FLYER") // FLYER | PROMO | ESTRENO | PARTIDO
  activo      Boolean  @default(true)
  creado_en   DateTime @default(now())

  // Relación con ServicioBase (opcional)
  servicio_id String?
  servicio   ServicioBase? @relation(fields: [servicio_id], references: [id])
}

/// ──────────────────────────────────────────
/// Modelo: Partido
/// Guía TV — partidos con horarios y canales.
/// Puede disparar notificación push a vendedores Pro.
/// ──────────────────────────────────────────
model Partido {
  id            String   @id @default(cuid())
  fecha         DateTime
  hora          String
  equipo_local  String
  equipo_visita String
  logo_local    String?
  logo_visita   String?
  canal                 String
  liga                  String?
  requiere_iptv         Boolean  @default(false)
  push_enviado          Boolean  @default(false)
  imagen_personalizada  String?  // Custom flyer uploaded by Admin
  activo                Boolean  @default(true)
}

/// ──────────────────────────────────────────
/// Modelo: MensajeRapido
/// Mensajes precargados con variables dinámicas para que los
/// vendedores los copien y envíen a sus clientes por WhatsApp.
/// ──────────────────────────────────────────
model MensajeRapido {
  id       String  @id @default(cuid())
  titulo   String
  template String
  orden    Int
  activo   Boolean @default(true)
}

/// ──────────────────────────────────────────
/// Modelo: Pedido
/// El vendedor solicita credenciales para un servicio.
/// Incluye comprobante de pago y cantidad solicitada.
/// ──────────────────────────────────────────
model Pedido {
  id               String    @id @default(cuid())
  vendor_id        String
  servicio_id      String
  cantidad         Int       @default(1)
  comprobante_url  String?   // Foto del comprobante de pago por credenciales
  notas            String?
  moneda           String    @default("BOB") // Moneda seleccionada: BOB o USD
  status           String    @default("PENDIENTE") // PENDIENTE | EN_PROCESO | COMPLETADO | CANCELADO
  respuesta_admin  String?   // Respuesta del admin (instrucciones, etc.)
  respondido_en    DateTime? // Timestamp de cuándo se respondió
  creado_en        DateTime  @default(now())

  vendor       Vendor        @relation(fields: [vendor_id], references: [id])
  servicio     ServicioBase? @relation(fields: [servicio_id], references: [id])
  credenciales Credencial[]  // Credenciales asignadas a este pedido
}

/// ──────────────────────────────────────────
/// Modelo: Pago
/// Registro de pagos de suscripción. El admin confirma o rechaza.
/// Al confirmar, se extiende la suscripción del vendor.
/// ──────────────────────────────────────────
model Pago {
  id              String    @id @default(cuid())
  vendor_id       String
  monto           Float
  plan_id         String
  comprobante_url String?
  moneda          String    @default("BOB") // Moneda seleccionada: BOB o USD
  status          String    @default("PENDIENTE") // PENDIENTE | CONFIRMADO | RECHAZADO
  confirmado_en   DateTime?
  notas_admin     String?
  creado_en       DateTime  @default(now())

  vendor Vendor @relation(fields: [vendor_id], references: [id])
  plan   Plan   @relation(fields: [plan_id], references: [id])
}

/// ──────────────────────────────────────────
/// Modelo: AjustesPlataforma
/// Configuración global: QR de cobro, texto legal, branding.
/// Solo existe 1 registro (singleton).
/// ──────────────────────────────────────────
model AjustesPlataforma {
  id                String  @id @default("1")
  qr_cobro_url      String  @default("")      // Legacy URL
  qr_cobro_bob      String  @default("")      // Nuevo QR exclusivo para Bs
  qr_cobro_usd      String  @default("")      // Nuevo QR exclusivo para USD
  tasa_cambio_bob   Float   @default(6.96)    // Tasa de cambio base
  tigo_money_numero String  @default("")
  texto_legal       String  @default("")
  nombre_plataforma String  @default("Ares")
  logo_url          String?
  noticia_global    String  @default("Bienvenido a Ares v2. Revisa los nuevos partidos.")
  whatsapp_soporte  String  @default("")
  
  // -- Configuración de Marca de Agua --
  watermark_enabled   Boolean @default(false)
  watermark_type      String  @default("TEXT") // TEXT | IMAGE
  watermark_text      String  @default("Ares Platform")
  watermark_image_url String  @default("")
  watermark_opacity   Float   @default(0.5)
}

/// ──────────────────────────────────────────
/// Modelo: Plataforma
/// Entidades de servicios streaming (Netflix, Disney+, etc.)
/// ──────────────────────────────────────────
model Plataforma {
  id        String   @id @default(cuid())
  nombre    String   @unique
  color     String   @default("#6B7280")
  emoji     String?
  activo    Boolean  @default(true)
  creado_en DateTime @default(now())

  estrenos  Estreno[]
}

/// ──────────────────────────────────────────
/// Modelo: Categoria
/// Categorías para servicios o imágenes.
/// ──────────────────────────────────────────
model Categoria {
  id        String   @id @default(cuid())
  nombre    String   @unique
  tipo      String   @default("SERVICIO") // SERVICIO | IMAGEN | OTRO
  activo    Boolean  @default(true)
  creado_en DateTime @default(now())
}


/// ──────────────────────────────────────────
/// Modelo: ClickMarketplace
/// Registro de interés en servicios del marketplace (Analytics).
/// ──────────────────────────────────────────
model ClickMarketplace {
  id           String   @id @default(cuid())
  vendor_id    String
  servicio_id  String
  proveedor_id String
  creado_en    DateTime @default(now())

  @@index([vendor_id])
  @@index([servicio_id])
  @@index([proveedor_id])
}
